@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace WebGPU {
+
+constexpr bool NeedsVertexPulling(std::uint32_t stride, std::uint32_t offset,
+                                  std::uint32_t size) {
+    if (size == 0) {
+        return false;
+    }
+    return stride % 4 != 0 || offset % std::min(4u, size) != 0 ||
+           (stride != 0 && (offset > stride || size > stride - offset));
+}
+
+} // namespace WebGPU
