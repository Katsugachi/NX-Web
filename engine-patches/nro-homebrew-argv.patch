diff --git a/src/core/loader/nro_path.h b/src/core/loader/nro_path.h
new file mode 100644
index 0000000000..a8ad416788
--- /dev/null
+++ b/src/core/loader/nro_path.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace Loader {
+
+inline std::string NroSdPath(std::string_view path) {
+    if (path.starts_with("sdmc:/")) {
+        return std::string{path};
+    }
+    if (const auto sdmc = path.find("/sdmc/"); sdmc != std::string_view::npos) {
+        return "sdmc:/" + std::string{path.substr(sdmc + 6)};
+    }
+    if (path.starts_with("/roms/switch/")) {
+        return "sdmc:/" + std::string{path.substr(6)};
+    }
+    const auto filename = path.substr(path.find_last_of("/\\") + 1);
+    const auto extension = filename.find_last_of('.');
+    return "sdmc:/switch/" + std::string{filename.substr(0, extension)} + "/" +
+           std::string{filename};
+}
+
+inline std::string NroArgv(std::string_view path, std::string_view arguments) {
+    std::string argv = "\"" + NroSdPath(path) + "\"";
+    if (!arguments.empty()) {
+        argv += ' ';
+        argv += arguments;
+    }
+    argv.push_back('\0');
+    return argv;
+}
+
+} // namespace Loader
