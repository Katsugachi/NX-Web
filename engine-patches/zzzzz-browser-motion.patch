+/// Controller-local gyro in turns/s and acceleration in g, with -Z at rest.
+EMSCRIPTEN_KEEPALIVE void eden_set_motion(int player, int delta_us, float gx, float gy, float gz,
+                                          float ax, float ay, float az) {
+    if (player < 0 || player >= static_cast<int>(g_pending_motion.size()) || delta_us < 0 ||
+        delta_us > 100000 ||
+        !std::ranges::all_of(std::array{gx, gy, gz, ax, ay, az},
+                            [](float value) { return std::isfinite(value) && std::abs(value) <= 16.0f; })) {
+        return;
+    }
+    {
+        std::scoped_lock lock{g_request_mutex};
+        g_pending_motion[player] = MotionSample{delta_us, {gx, gy, gz}, {ax, ay, az}};
+        g_motion_pending = true;
+    }
+    g_request_cv.notify_one();
+}
