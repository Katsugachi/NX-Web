+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <span>
+
+namespace Common::FS {
+
+class SequentialRead {
+public:
+    void Reset() {
+        position.reset();
+    }
+
+    template <typename File>
+    std::size_t Read(File& file, std::span<std::uint8_t> data, std::size_t offset) {
+        if (offset > static_cast<std::size_t>(std::numeric_limits<std::int64_t>::max())) {
+            Reset();
+            return 0;
+        }
+        if (position != offset && !file.Seek(static_cast<std::int64_t>(offset))) {
+            Reset();
+            return 0;
+        }
+        const auto count = file.ReadSpan(data);
+        if (count == data.size() && count <= std::numeric_limits<std::size_t>::max() - offset) {
+            position = offset + count;
+        } else {
+            Reset();
+        }
+        return count;
+    }
+
+private:
+    std::optional<std::size_t> position;
+};
+
+} // namespace Common::FS
