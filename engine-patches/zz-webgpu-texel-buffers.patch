+inline bool FitsTexelBufferBindings(std::span<const Shader::TextureBufferDescriptor> descriptors,
+                                    u32 capacity) {
+    u32 count{};
+    for (const auto& desc : descriptors) {
+        if (desc.count > capacity - count) {
+            return false;
+        }
+        count += desc.count;
+    }
+    return true;
+}
+
+struct TexelBufferFormat {
+    u32 bits;
+    u32 components;
+    u32 kind; ///< Float, uint, sint, unorm, snorm (0 through 4).
+
+    constexpr u32 Bytes() const { return bits * components / 8; }
+    constexpr u32 Packed() const { return bits | (components << 8) | (kind << 16); }
+};
+
+inline std::optional<TexelBufferFormat> GetTexelBufferFormat(VideoCore::Surface::PixelFormat format) {
+    using VideoCore::Surface::PixelFormat;
+    switch (format) {
+    case PixelFormat::R32_FLOAT:
+        return TexelBufferFormat{32, 1, 0};
+    case PixelFormat::R32G32_FLOAT:
+        return TexelBufferFormat{32, 2, 0};
+    case PixelFormat::R32G32B32_FLOAT:
+        return TexelBufferFormat{32, 3, 0};
+    case PixelFormat::R32G32B32A32_FLOAT:
+        return TexelBufferFormat{32, 4, 0};
+    case PixelFormat::R16_FLOAT:
+        return TexelBufferFormat{16, 1, 0};
+    case PixelFormat::R16G16_FLOAT:
+        return TexelBufferFormat{16, 2, 0};
+    case PixelFormat::R16G16B16A16_FLOAT:
+        return TexelBufferFormat{16, 4, 0};
+    case PixelFormat::R32_UINT:
+        return TexelBufferFormat{32, 1, 1};
+    case PixelFormat::R32G32_UINT:
+        return TexelBufferFormat{32, 2, 1};
+    case PixelFormat::R32G32B32A32_UINT:
+        return TexelBufferFormat{32, 4, 1};
+    case PixelFormat::R16_UINT:
+        return TexelBufferFormat{16, 1, 1};
+    case PixelFormat::R16G16_UINT:
+        return TexelBufferFormat{16, 2, 1};
+    case PixelFormat::R16G16B16A16_UINT:
+        return TexelBufferFormat{16, 4, 1};
+    case PixelFormat::R8_UINT:
+        return TexelBufferFormat{8, 1, 1};
+    case PixelFormat::R8G8_UINT:
+        return TexelBufferFormat{8, 2, 1};
+    case PixelFormat::A8B8G8R8_UINT:
+        return TexelBufferFormat{8, 4, 1};
+    case PixelFormat::R32_SINT:
+        return TexelBufferFormat{32, 1, 2};
+    case PixelFormat::R32G32_SINT:
+        return TexelBufferFormat{32, 2, 2};
+    case PixelFormat::R32G32B32A32_SINT:
+        return TexelBufferFormat{32, 4, 2};
+    case PixelFormat::R16_SINT:
+        return TexelBufferFormat{16, 1, 2};
+    case PixelFormat::R16G16_SINT:
+        return TexelBufferFormat{16, 2, 2};
+    case PixelFormat::R16G16B16A16_SINT:
+        return TexelBufferFormat{16, 4, 2};
+    case PixelFormat::R8_SINT:
+        return TexelBufferFormat{8, 1, 2};
+    case PixelFormat::R8G8_SINT:
+        return TexelBufferFormat{8, 2, 2};
+    case PixelFormat::A8B8G8R8_SINT:
+        return TexelBufferFormat{8, 4, 2};
+    case PixelFormat::R16_UNORM:
+        return TexelBufferFormat{16, 1, 3};
+    case PixelFormat::R16G16_UNORM:
+        return TexelBufferFormat{16, 2, 3};
+    case PixelFormat::R16G16B16A16_UNORM:
+        return TexelBufferFormat{16, 4, 3};
+    case PixelFormat::R8_UNORM:
+        return TexelBufferFormat{8, 1, 3};
+    case PixelFormat::R8G8_UNORM:
