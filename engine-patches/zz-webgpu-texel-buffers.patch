+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <iostream>
+#include <limits>
+#include <catch2/catch_test_macros.hpp>
+#include "shader_recompiler/backend/wgsl/wgsl_emit_context.h"
+#include "video_core/renderer_webgpu/wgpu_texel_buffer.h"
+
+TEST_CASE("WebGPU texel arrays fit the fixed cache before binding", "[shader][texel-buffer]") {
+    std::array<Shader::TextureBufferDescriptor, 2> descriptors{};
+    CHECK(WebGPU::FitsTexelBufferBindings({}, 32));
+    descriptors[0].count = 32;
+    CHECK(WebGPU::FitsTexelBufferBindings(descriptors, 32));
+    descriptors[0].count = 33;
+    CHECK_FALSE(WebGPU::FitsTexelBufferBindings(descriptors, 32));
+    descriptors[0].count = 16;
+    descriptors[1].count = 17;
+    CHECK_FALSE(WebGPU::FitsTexelBufferBindings(descriptors, 32));
+    descriptors[0].count = std::numeric_limits<u32>::max();
+    CHECK_FALSE(WebGPU::FitsTexelBufferBindings(descriptors, 32));
+}
+
+TEST_CASE("WebGPU texel buffer format layouts", "[shader][texel-buffer]") {
+    using VideoCore::Surface::PixelFormat;
+    const auto floats = WebGPU::GetTexelBufferFormat(PixelFormat::R32G32B32A32_FLOAT);
+    REQUIRE(floats);
+    CHECK(floats->Bytes() == 16);
+    CHECK(floats->Packed() == (32 | (4 << 8)));
+    const auto snorm = WebGPU::GetTexelBufferFormat(PixelFormat::A8B8G8R8_SNORM);
+    REQUIRE(snorm);
+    CHECK(snorm->Bytes() == 4);
+    CHECK(snorm->kind == 4);
+    CHECK_FALSE(WebGPU::GetTexelBufferFormat(PixelFormat::BC1_RGBA_UNORM));
+}
+
+TEST_CASE("WebGPU texel buffers have distinct storage and metadata bindings", "[shader][texel-buffer]") {
+    using namespace Shader;
+    IR::Program program;
+    program.stage = Stage::VertexB;
+    program.info.texture_buffer_descriptors.push_back({.count = 2});
+    Backend::Bindings bindings;
+    Backend::WGSL::EmitContext ctx{program, bindings, Profile{}, RuntimeInfo{}, {}};
+    REQUIRE(ctx.texture_buffers.size() == 1);
+    CHECK(ctx.texture_buffers[0].first == 0);
+    CHECK(ctx.texture_buffers[0].second == 2);
+    CHECK(bindings.unified == 4);
+    CHECK(ctx.header.find("tbo_fetch0") != std::string::npos);
+    CHECK(ctx.header.find("tbo_fetch2") != std::string::npos);
+    CHECK(ctx.header.find("if(index>=texel_info.y)") != std::string::npos);
+    const auto begin = ctx.header.find("@group(0) @binding(0) var<storage, read> tbo0");
+    const auto end = ctx.header.find("return result;}", begin);
+    REQUIRE(begin != std::string::npos);
+    REQUIRE(end != std::string::npos);
+    std::cout << "TBO_SHADER_BEGIN\n" << ctx.header.substr(begin, end + 15 - begin)
+              << "\nTBO_SHADER_END\n";
+
+    IR::Program empty;
+    empty.stage = Stage::VertexB;
+    Backend::Bindings empty_bindings;
+    Backend::WGSL::EmitContext empty_ctx{empty, empty_bindings, Profile{}, RuntimeInfo{}, {}};
+    CHECK(empty_ctx.texture_buffers.empty());
+    CHECK(empty_ctx.header.find("tbo_fetch") == std::string::npos);
+}
