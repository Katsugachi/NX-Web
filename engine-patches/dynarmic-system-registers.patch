 using namespace Dynarmic;
 using namespace oaknut::util;
 
+TEST_CASE("A64: TPIDR2_EL0 requires SME", "[a64][system-registers]") {
+    class ExceptionEnv final : public A64TestEnv {
+    public:
+        std::vector<std::pair<u64, A64::Exception>> exceptions;
+        void ExceptionRaised(u64 pc, A64::Exception exception) override {
+            exceptions.emplace_back(pc, exception);
+        }
+    };
+    for (const u32 instruction : {0xd53bd0a1U, 0xd51bd0a1U}) {
+        ExceptionEnv env;
+        A64::UserConfig config{};
+        config.callbacks = &env;
+        A64::Jit jit{config};
+        env.code_mem = {instruction, 0x14000000};
+        jit.SetRegister(1, 0x12345678);
+        jit.SetPC(0);
+        env.ticks_left = 1;
+        jit.Step();
+        REQUIRE(env.exceptions.size() == 1);
+        CHECK(env.exceptions[0].first == 0);
+        CHECK(env.exceptions[0].second == A64::Exception::UnallocatedEncoding);
+        CHECK(jit.GetRegister(1) == 0x12345678);
+    }
+}
+
+TEST_CASE("A64: guarded TPIDR2_EL0 can be compiled without executing it", "[a64][system-registers]") {
+    A64TestEnv env;
+    A64::UserConfig config{};
+    config.callbacks = &env;
+    A64::Jit jit{config};
+    env.code_mem = {
+        0xd2800000, // MOV X0, #0
+        0xb4000040, // CBZ X0, +8
+        0xd53bd0a1, // MRS X1, TPIDR2_EL0
+        0x91000442, // ADD X2, X2, #1
+        0x17fffffd, // B -12
+    };
+    jit.SetRegister(1, 42);
+    jit.SetRegister(2, 0);
+    jit.SetPC(0);
+    env.ticks_left = 1000;
+    jit.Run();
+    CHECK(jit.GetRegister(1) == 42);
+    CHECK(jit.GetRegister(2) > 0);
+}
+
