+            text += fmt::format("patch{}:vec4<f32>,\n", index);
+        }
+    }
+    text += "outer:vec4<f32>, inner:vec4<f32> }\n";
+    if (compute) {
+        text += R"(
+struct TessArgs { count:atomic<u32>, instances:u32, first:u32, base:u32, overflow:atomic<u32> }
+@group(3) @binding(0) var<storage,read_write> tess_patches:array<TessPatch>;
+@group(3) @binding(1) var<storage,read_write> tess_records:array<vec4<u32>>;
+@group(3) @binding(2) var<storage,read_write> tess_args:TessArgs;
+var<private> tess_patch_index:u32;
+fn tess_reserve(count:u32)->u32 {
+    let capacity=min(draw_info.tess_draw.w,arrayLength(&tess_records));
+    for(var attempt=0u;attempt<1024u;attempt++) {
+        let old=atomicLoad(&tess_args.count);
+        if (count>capacity || old>capacity-count) {
+            atomicStore(&tess_args.overflow,1u); return 0xffffffffu;
+        }
+        let result=atomicCompareExchangeWeak(&tess_args.count,old,old+count);
+        if (result.exchanged) { return old; }
+    }
+    atomicStore(&tess_args.overflow,1u); return 0xffffffffu;
+}
+fn tess_record(index:u32,uv:vec2<f32>) {
+    tess_records[index]=vec4<u32>(tess_patch_index,bitcast<u32>(uv.x),bitcast<u32>(uv.y),0u);
+}
+)";
+        text += fmt::format("const tess_spacing={}u;\nconst tess_mode={}u;\n",
+                            static_cast<u32>(runtime_info.tess_spacing), output_mode);
+        text += R"(
+fn tess_point(a:vec2<f32>) {
+    if (tess_mode!=0u) { return; }
+    let index=tess_reserve(1u);
+    if(index!=0xffffffffu) { tess_record(index,a); }
+}
+fn tess_line(a:vec2<f32>,b:vec2<f32>) {
+    if (tess_mode==0u) { return; }
+    let index=tess_reserve(2u);
+    if(index!=0xffffffffu) { tess_record(index,a); tess_record(index+1u,b); }
+}
+fn tess_triangle(a:vec2<f32>,v1:vec2<f32>,v2:vec2<f32>) {
+    if (tess_mode==0u) { return; }
+    var b=v1; var c=v2;
+)";
+        if (runtime_info.tess_clockwise) {
+            text += "b=v2; c=v1;\n";
+        }
+        text += R"(
+    if(tess_mode==1u) {
+        let index=tess_reserve(6u);
+        if(index==0xffffffffu) { return; }
+        tess_record(index,a); tess_record(index+1u,b);
+        tess_record(index+2u,b); tess_record(index+3u,c);
+        tess_record(index+4u,c); tess_record(index+5u,a);
+    } else {
+        let index=tess_reserve(3u);
+        if(index==0xffffffffu) { return; }
+        tess_record(index,a); tess_record(index+1u,b); tess_record(index+2u,c);
+    }
+}
+)";
+        text += TESSELLATOR;
+        text += fmt::format("@group({}) @binding({}) var<storage,read> tess_indices:array<u32>;\n",
+                            PULLED_VERTEX_GROUP, MAX_PULLED_BUFFERS + 1);
+        text += R"(
+@compute @workgroup_size(1) fn tess_main(@builtin(global_invocation_id) id:vec3<u32>) {
+    if(id.x>=min(draw_info.tess_draw.x*draw_info.tess_draw.y,arrayLength(&tess_patches)) || draw_info.tess_draw.x==0u) { return; }
+    tess_patch_index=id.x;
+    let primitive=id.x%draw_info.tess_draw.x;
+    let instance=id.x/draw_info.tess_draw.x+draw_info.base_instance;
+    tess_patches[id.x].outer=draw_info.tess_outer;
+    tess_patches[id.x].inner=draw_info.tess_inner;
+    var input:s0_VSInput; input.instance_index=instance;
+)";
+        if (control) {
+            for (size_t index = 0; index < control->info.uses_patches.size(); ++index) {
+                if (control->info.uses_patches[index]) {
+                    text += fmt::format("s2_patch_attr{}=vec4<f32>();\n", index);
+                }
+            }
+            text += "for(var i=0u;i<4u;i++){s2_tess_outer[i]=tess_patches[id.x].outer[i];}\n"
+                    "for(var i=0u;i<2u;i++){s2_tess_inner[i]=tess_patches[id.x].inner[i];}\n"
+                    "s2_v_primitive_id=primitive; s2_v_instance_id=instance;\n";
+        }
+        text += fmt::format("for(var k=0u;k<{}u;k++){{\n"
+                            "let address=u32(draw_info.render_area.w)/4u+primitive*{}u+k;\n"
+                            "let guest=tess_indices[address]+draw_info.base_vertex;\n"
+                            "input.vertex_index=guest; let value=s0_run(input,guest);\n",
+                            patch_size, patch_size);
+        text += control ? "s2_in_position[k]=value.position;\n"
