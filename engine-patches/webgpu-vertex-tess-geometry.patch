+void ConvertGeometryIndices(Maxwell::PrimitiveTopology topology, std::span<const u32> in,
+                            std::vector<u32>& out, bool restart, u32 restart_index) {
+    using Topology = Maxwell::PrimitiveTopology;
+    out.clear();
+    size_t first{};
+    for (size_t end = 0; end <= in.size(); ++end) {
+        if (end != in.size() && (!restart || in[end] != restart_index)) {
+            continue;
+        }
+        const auto segment = in.subspan(first, end - first);
+        std::vector<u32> list;
+        u32 width = 3;
+        switch (topology) {
+        case Topology::Points:
+            width = 1;
+            list.assign(segment.begin(), segment.end());
+            break;
+        case Topology::Lines:
+            width = 2;
+            list.assign(segment.begin(), segment.end());
+            break;
+        case Topology::LineStrip:
+            width = 2;
+            for (size_t i = 0; i + 1 < segment.size(); ++i) {
+                list.insert(list.end(), {segment[i], segment[i + 1]});
+            }
+            break;
+        case Topology::LineLoop:
+            width = 2;
+            ConvertIndices(topology, segment, list);
+            break;
+        case Topology::LinesAdjacency:
+            width = 4;
+            list.assign(segment.begin(), segment.end());
+            break;
+        case Topology::LineStripAdjacency:
+            width = 4;
+            for (size_t i = 0; i + 3 < segment.size(); ++i) {
+                list.insert(list.end(), segment.begin() + i, segment.begin() + i + 4);
+            }
+            break;
+        case Topology::TrianglesAdjacency:
+            width = 6;
+            list.assign(segment.begin(), segment.end());
+            break;
+        case Topology::TriangleStripAdjacency:
+            width = 6;
+            for (size_t i = 0; i + 5 < segment.size(); i += 2) {
+                const size_t next = i + 7 < segment.size() ? i + 6 : i + 5;
+                if (i == 0) {
+                    list.insert(list.end(), {segment[0], segment[1], segment[2], segment[next],
+                                             segment[4], segment[3]});
+                    continue;
+                }
+                if ((i / 2) & 1) {
+                    list.insert(list.end(), {segment[i + 2], segment[i - 2], segment[i],
+                                             segment[i + 3], segment[i + 4], segment[next]});
+                } else {
+                    list.insert(list.end(), {segment[i], segment[i - 2], segment[i + 2],
+                                             segment[next], segment[i + 4], segment[i + 3]});
+                }
+            }
+            break;
+        case Topology::TriangleStrip:
+            for (size_t i = 0; i + 2 < segment.size(); ++i) {
+                list.insert(list.end(),
+                            {segment[i + (i & 1)], segment[i + 1 - (i & 1)], segment[i + 2]});
+            }
+            break;
+        default:
+            ConvertIndices(topology, segment, list);
+            break;
+        }
+        list.resize(list.size() / width * width);
+        out.insert(out.end(), list.begin(), list.end());
+        first = end + 1;
+    }
+}
