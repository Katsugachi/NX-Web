+        }
+        for (size_t index = 0; index < evaluation.info.uses_patches.size(); ++index) {
+            if (evaluation.info.uses_patches[index] ||
+                (control && control->info.uses_patches[index])) {
+                text += fmt::format("tess_patches[id.x].patch{}={};\n", index,
+                                    control && control->info.uses_patches[index]
+                                        ? fmt::format("s2_patch_attr{}", index)
+                                        : "vec4<f32>()");
+            }
+        }
+        if (control) {
+            text += "for(var i=0u;i<4u;i++){tess_patches[id.x].outer[i]=s2_tess_outer[i];}\n"
