index 0000000000..5d6e2a4681
--- /dev/null
+++ b/src/shader_recompiler/backend/wgsl/tessellator.h
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <string_view>
+
+namespace Shader::Backend::WGSL {
+
+constexpr std::string_view TESSELLATOR = R"(
+fn tess_positive(level:f32)->bool {
+    return level>0.0 && (bitcast<u32>(level)&0x7fffffffu)<=0x7f800000u;
+}
+fn tess_segments(level: f32, spacing: u32) -> u32 {
+    let minimum = select(1.0, 2.0, spacing == 2u);
+    let maximum = select(64.0, 63.0, spacing == 1u);
+    let finite = select(level,minimum,(bitcast<u32>(level)&0x7fffffffu)>0x7f800000u);
+    let value = clamp(finite, minimum, maximum);
+    var n = u32(ceil(value));
+    if (spacing == 1u) { n += 1u - (n & 1u); }
+    if (spacing == 2u) { n += n & 1u; }
+    return clamp(n,1u,64u);
+}
+fn tess_parameter(i: u32, n: u32, level: f32, spacing: u32) -> f32 {
+    if (i == 0u) { return 0.0; }
+    if (i == n) { return 1.0; }
+    if (spacing == 0u || n == 1u) { return f32(i) / f32(n); }
+    let f = clamp(level, select(1.0, 2.0, spacing == 2u), select(64.0, 63.0, spacing == 1u));
+    return (1.0 - f32(n - 2u) / f) * 0.5 + f32(i - 1u) / f;
+}
+fn tess_tri_edge(a: f32, side: u32, t: f32) -> vec2<f32> {
+    let s = 1.0 - 3.0*a;
+    if (side == 0u) { return vec2<f32>(a + s*t, a); }
+    if (side == 1u) { return vec2<f32>(a + s*(1.0-t), a + s*t); }
+    return vec2<f32>(a, a + s*(1.0-t));
+}
+fn tess_join_tri(a: f32, b: f32, side: u32, n: u32, m: u32, level: f32, spacing: u32) {
+    var i = 0u;
+    var j = 0u;
+    for(var step=0u;step<128u;step++) {
+        if (i == n && j == m) { break; }
+        let x = tess_tri_edge(a, side, tess_parameter(i, n, level, spacing));
+        let y = tess_tri_edge(b, side, f32(j) / f32(max(m,1u)));
+        if (i < n && (j == m || f32(i+1u)*f32(m) <= f32(j+1u)*f32(n))) {
+            tess_triangle(x, tess_tri_edge(a, side, tess_parameter(i+1u,n,level,spacing)), y);
+            i++;
+        } else {
+            tess_triangle(x, tess_tri_edge(b,side,f32(j+1u)/f32(m)), y);
+            j++;
+        }
+    }
+}
+fn tess_triangles(outer: vec4<f32>, inner: vec2<f32>) {
+    let levels = vec3<f32>(outer.y, outer.z, outer.x);
+    if (!tess_positive(outer.x) || !tess_positive(outer.y) || !tess_positive(outer.z)) { return; }
+    var n = tess_segments(inner.x, tess_spacing);
+    var counts = vec3<u32>();
+    for (var side=0u; side<3u; side++) { counts[side]=tess_segments(levels[side],tess_spacing); }
+    if (n == 1u && all(counts == vec3<u32>(1u))) {
+        tess_point(vec2<f32>(0.0,0.0)); tess_point(vec2<f32>(1.0,0.0)); tess_point(vec2<f32>(0.0,1.0));
+        tess_triangle(vec2<f32>(0.0,0.0),vec2<f32>(1.0,0.0),vec2<f32>(0.0,1.0)); return;
+    }
+    var level = max(inner.x, 1.000001);
+    n = tess_segments(level,tess_spacing);
+    let first = tess_parameter(1u,n,level,tess_spacing);
+    var a = 0.0;
+    var b = first * (2.0/3.0);
+    var m = n-2u;
+    for (var side=0u;side<3u;side++) {
+        for (var i=0u;i<64u;i++) { if(i>=counts[side]){break;} tess_point(tess_tri_edge(0.0,side,tess_parameter(i,counts[side],levels[side],tess_spacing))); }
+        tess_join_tri(a,b,side,counts[side],m,levels[side],tess_spacing);
+    }
+    for(var ring=0u;ring<32u;ring++) {
+        if (m == 0u) { tess_point(vec2<f32>(1.0/3.0)); break; }
+        for (var side=0u;side<3u;side++) {
+            for (var i=0u;i<64u;i++) { if(i>=m){break;} tess_point(tess_tri_edge(b,side,f32(i)/f32(m))); }
+        }
+        if (m == 1u) {
+            tess_triangle(tess_tri_edge(b,0u,0.0),tess_tri_edge(b,1u,0.0),tess_tri_edge(b,2u,0.0)); break;
+        }
+        a=b;
+        b += (1.0-3.0*a)/f32(m)*(2.0/3.0);
+        let next=m-2u;
+        for(var side=0u;side<3u;side++) { tess_join_tri(a,b,side,m,next,1.0,0u); }
+        m=next;
+    }
+}
+fn tess_quad_edge(side: u32, t: f32) -> vec2<f32> {
+    if(side==0u) { return vec2<f32>(t,0.0); }
+    if(side==1u) { return vec2<f32>(1.0,t); }
+    if(side==2u) { return vec2<f32>(1.0-t,1.0); }
+    return vec2<f32>(0.0,1.0-t);
+}
+fn tess_quads(outer:vec4<f32>,inner:vec2<f32>) {
+    if(!tess_positive(outer.x) || !tess_positive(outer.y) || !tess_positive(outer.z) || !tess_positive(outer.w)) { return; }
+    let levels=vec4<f32>(outer.y,outer.z,outer.w,outer.x);
+    var counts=vec4<u32>();
+    for(var side=0u;side<4u;side++) { counts[side]=tess_segments(levels[side],tess_spacing); }
+    var nu=tess_segments(inner.y,tess_spacing);
+    var nv=tess_segments(inner.x,tess_spacing);
+    if(nu==1u && nv==1u && all(counts==vec4<u32>(1u))) {
+        for(var side=0u;side<4u;side++) { tess_point(tess_quad_edge(side,0.0)); }
+        tess_triangle(vec2<f32>(0.0,0.0),vec2<f32>(1.0,0.0),vec2<f32>(1.0,1.0));
+        tess_triangle(vec2<f32>(0.0,0.0),vec2<f32>(1.0,1.0),vec2<f32>(0.0,1.0)); return;
+    }
+    let ulevel=max(inner.y,1.000001);
+    let vlevel=max(inner.x,1.000001);
+    nu=tess_segments(ulevel,tess_spacing); nv=tess_segments(vlevel,tess_spacing);
+    let lo=vec2<f32>(tess_parameter(1u,nu,ulevel,tess_spacing),tess_parameter(1u,nv,vlevel,tess_spacing));
+    let hi=vec2<f32>(1.0)-lo;
+    for(var y=1u;y<64u;y++) { if(y>=nv){break;} for(var x=1u;x<64u;x++) { if(x>=nu){break;}
+        let a=vec2<f32>(tess_parameter(x,nu,ulevel,tess_spacing),tess_parameter(y,nv,vlevel,tess_spacing));
+        tess_point(a);
+        if(x+1u<nu && y+1u<nv) {
+            let b=vec2<f32>(tess_parameter(x+1u,nu,ulevel,tess_spacing),a.y);
+            let c=vec2<f32>(b.x,tess_parameter(y+1u,nv,vlevel,tess_spacing));
+            let d=vec2<f32>(a.x,c.y);
+            tess_triangle(a,b,c); tess_triangle(a,c,d);
+        }
+    }}
+    for(var side=0u;side<4u;side++) {
+        let n=counts[side];
+        let m=select(nu-2u,nv-2u,(side&1u)!=0u);
+        var i=0u; var j=0u;
+        for(var k=0u;k<64u;k++) { if(k>=n){break;} tess_point(tess_quad_edge(side,tess_parameter(k,n,levels[side],tess_spacing))); }
+        for(var step=0u;step<128u;step++) {
+            if(i==n && j==m) { break; }
+            let a=tess_quad_edge(side,tess_parameter(i,n,levels[side],tess_spacing));
+            let b=lo+(hi-lo)*tess_quad_edge(side,f32(j)/f32(max(m,1u)));
+            if(i<n && (j==m || f32(i+1u)*f32(m)<=f32(j+1u)*f32(n))) {
+                tess_triangle(a,tess_quad_edge(side,tess_parameter(i+1u,n,levels[side],tess_spacing)),b); i++;
+            } else {
+                tess_triangle(a,lo+(hi-lo)*tess_quad_edge(side,f32(j+1u)/f32(m)),b); j++;
+            }
+        }
+    }
+}
+fn tess_isolines(outer:vec4<f32>) {
+    if(!tess_positive(outer.x) || !tess_positive(outer.y)) { return; }
+    let lines=tess_segments(outer.x,0u);
+    let segments=tess_segments(outer.y,tess_spacing);
+    for(var line=0u;line<64u;line++) { if(line>=lines){break;}
+        for(var i=0u;i<65u;i++) { if(i>segments){break;}
+            let a=vec2<f32>(tess_parameter(i,segments,outer.y,tess_spacing),f32(line)/f32(lines));
+            tess_point(a);
+            if(i<segments) { tess_line(a,vec2<f32>(tess_parameter(i+1u,segments,outer.y,tess_spacing),a.y)); }
+        }
+    }
+}
+)";
+
+} // namespace Shader::Backend::WGSL
