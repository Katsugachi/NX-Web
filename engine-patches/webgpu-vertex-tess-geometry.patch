+            text += control ? fmt::format("s2_in_attr{}[k]={};\n", index, value)
+                            : fmt::format("tess_patches[id.x].cp[k].attr{}={};\n", index, value);
+        }
+        text += "}\n";
+        if (control) {
+            text += fmt::format("for(var invocation=0u;invocation<{}u;invocation++){{\n"
+                                "s2_v_invocation_id=invocation; s2_run();\n"
+                                "tess_patches[id.x].cp[invocation].position=s2_v_position;\n",
