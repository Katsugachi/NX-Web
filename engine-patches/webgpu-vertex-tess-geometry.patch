+std::string EmitGeometryEntry(const IR::Program& vertex, const IR::Program& geometry,
+                              const RuntimeInfo& runtime_info, const Options& options) {
+    const u32 width = geometry.output_topology == OutputTopology::TriangleStrip ? 3
+                      : geometry.output_topology == OutputTopology::LineStrip   ? 2
+                                                                                : 1;
+    const u32 slots =
+        geometry.output_vertices >= width ? (geometry.output_vertices - width + 1) * width : 0;
+    const u32 inputs = InputTopologyVertices::vertices(runtime_info.input_topology);
+    std::string text = "struct GSOutput {\n@builtin(position) position: vec4<f32>,\n";
+    for (size_t index = 0; index < IR::NUM_GENERICS; ++index) {
+        if (geometry.info.stores.Generic(index)) {
+            const auto interp = options.output_interpolation[index];
+            text += fmt::format("@location({}) @interpolate({}) out{}: vec4<f32>,\n", index,
+                                interp == Interpolation::Flat            ? "flat"
+                                : interp == Interpolation::NoPerspective ? "linear"
+                                                                         : "perspective",
+                                index);
+        }
+    }
+    text += "}\nvar<private> gs_ring: array<GSOutput, 3>;\n"
+            "var<private> gs_result: GSOutput;\nvar<private> gs_strip: u32;\n"
+            "var<private> gs_primitive: u32;\nvar<private> gs_target: u32;\n"
+            "var<private> gs_corner: u32;\nvar<private> gs_done: bool;\n"
+            "fn gs_end() { gs_strip = 0u; }\n"
+            "fn gs_emit() {\nif (gs_done) { return; }\n"
+            "var value: GSOutput;\nvalue.position = s4_v_position;\n";
+    for (size_t index = 0; index < IR::NUM_GENERICS; ++index) {
+        if (geometry.info.stores.Generic(index)) {
+            text += fmt::format("value.out{0} = s4_out_attr{0};\n", index);
+        }
+    }
+    text += fmt::format("gs_ring[gs_strip % 3u] = value;\ngs_strip++;\n"
+                        "if (gs_strip < {}u) {{ return; }}\n"
+                        "if (gs_primitive == gs_target) {{\nvar corner = gs_corner;\n",
+                        width);
+    if (width == 3) {
+        text += "if ((gs_strip & 1u) == 0u && corner < 2u) { corner = 1u - corner; }\n";
+    }
+    text += fmt::format("gs_result = gs_ring[(gs_strip - {}u + corner) % 3u];\n"
+                        "gs_done = true;\n}}\ngs_primitive++;\n}}\n",
+                        width);
+    text += fmt::format("@group({}) @binding({}) var<storage, read> gs_indices: array<u32>;\n",
+                        PULLED_VERTEX_GROUP, MAX_PULLED_BUFFERS + 1);
+    text +=
+        fmt::format("@vertex fn main(input: s0_VSInput) -> GSOutput {{\n"
+                    "let local = input.vertex_index;\nlet primitive = local / {}u;\n"
+                    "s4_v_invocation_id = (local / {}u) % {}u;\n"
+                    "s4_v_primitive_id = primitive;\n"
+                    "s4_v_instance_id = input.instance_index;\n"
+                    "gs_strip = 0u;\ngs_primitive = 0u;\ngs_done = false;\n"
+                    "gs_result = GSOutput();\ngs_target = (local % {}u) / {}u;\n"
+                    "gs_corner = local % {}u;\n",
+                    std::max(slots, 1u) * std::max(geometry.invocations, 1u), std::max(slots, 1u),
+                    std::max(geometry.invocations, 1u), std::max(slots, 1u), width, width);
+    text += fmt::format("for (var k = 0u; k < {}u; k++) {{\n"
+                        "let address = u32(draw_info.render_area.w) / 4u + primitive * {}u + k;\n"
+                        "let guest = gs_indices[address] + draw_info.base_vertex;\n"
+                        "let value = s0_run(input, guest);\ns4_in_position[k] = value.position;\n",
+                        inputs, inputs);
+    for (size_t index = 0; index < IR::NUM_GENERICS; ++index) {
+        if (geometry.info.loads.Generic(index)) {
+            text +=
+                fmt::format("s4_in_attr{0}[k] = {1};\n", index,
+                            vertex.info.stores.Generic(index) ? fmt::format("value.out{}", index)
+                                                              : "vec4<f32>(0.0, 0.0, 0.0, 1.0)");
+        }
+    }
+    text += "}\ns4_run();\nvar pos = gs_result.position;\n";
+    if (runtime_info.convert_depth_mode) {
+        text += "pos.z = (pos.z + pos.w) * 0.5;\n";
+    }
+    text += "if (draw_info.depth_flip != 0u) { pos.z = pos.w - pos.z; }\n"
+            "pos.x = pos.x * draw_info.viewport.x + pos.w * draw_info.viewport.y;\n"
+            "pos.y = pos.y * draw_info.viewport.z + pos.w * draw_info.viewport.w;\n"
+            "gs_result.position = pos;\nreturn gs_result;\n}\n";
+    return text;
+}
