 /// Moves a stick (0 left, 1 right) to x, y in [-1, 1], with +y up.
 EMSCRIPTEN_KEEPALIVE void eden_set_stick(int player, int stick, float x, float y) {
     PushRequest({.kind = Request::Kind::Stick, .player = player, .id = stick, .x = x, .y = y});
+}
+
+/// A contact in Switch touchscreen pixels (1280x720); releasing only needs its id (0..15).
+EMSCRIPTEN_KEEPALIVE void eden_set_touch(int id, float x, float y, int pressed) {
+    if (id < 0 || id >= 16 || !std::isfinite(x) || !std::isfinite(y)) {
+        return;
+    }
+    PushRequest({.kind = Request::Kind::Touch, .id = id, .pressed = pressed != 0,
+                 .x = std::clamp(x / 1280.0f, 0.0f, 1.0f),
+                 .y = std::clamp(y / 720.0f, 0.0f, 1.0f)});
 }
 
